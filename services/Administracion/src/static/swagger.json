  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CrearRestaurante": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 3, "maxLength": 150 },
          "description": { "type": "string" },
          "logo_url": { "type": "string" }
        }
      },
      "ActualizarRestaurante": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 3, "maxLength": 150 },
          "description": { "type": "string" },
          "logo_url": { "type": "string" },
          "is_active": { "type": "boolean" }
        }
      },
      "CrearSucursal": {
        "type": "object",
        "required": ["restaurante_id", "name", "address"],
        "properties": {
          "restaurante_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 3, "maxLength": 150 },
          "address": { "type": "string" },
          "phone": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        }
      },
      "ActualizarSucursal": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 3, "maxLength": 150 },
          "address": { "type": "string" },
          "phone": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "is_active": { "type": "boolean" }
        }
      },
      "CrearMesa": {
        "type": "object",
        "required": ["sucursal_id", "table_number", "capacity_min", "capacity_max"],
        "properties": {
          "sucursal_id": { "type": "string", "format": "uuid" },
          "table_number": { "type": "string" },
          "capacity_min": { "type": "integer", "minimum": 1 },
          "capacity_max": { "type": "integer", "minimum": 1 },
          "location": { "type": "string" }
        }
      },
      "ActualizarMesa": {
        "type": "object",
        "properties": {
          "table_number": { "type": "string" },
          "capacity_min": { "type": "integer", "minimum": 1 },
          "capacity_max": { "type": "integer", "minimum": 1 },
          "location": { "type": "string" },
          "is_active": { "type": "boolean" }
        }
      },
      "CrearHorario": {
        "type": "object",
        "required": ["sucursal_id", "day_of_week", "opening_time", "closing_time"],
        "properties": {
          "sucursal_id": { "type": "string", "format": "uuid" },
          "day_of_week": { "type": "integer", "minimum": 0, "maximum": 6 },
          "opening_time": { "type": "string", "format": "time" },
          "closing_time": { "type": "string", "format": "time" }
        }
      },
      "ActualizarHorario": {
        "type": "object",
        "properties": {
          "day_of_week": { "type": "integer", "minimum": 0, "maximum": 6 },
          "opening_time": { "type": "string", "format": "time" },
          "closing_time": { "type": "string", "format": "time" },
          "is_closed": { "type": "boolean" }
        }
      },
      "CrearPromocion": {
        "type": "object",
        "required": ["sucursal_id", "name", "start_date", "end_date"],
        "properties": {
          "sucursal_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 3, "maxLength": 150 },
          "description": { "type": "string" },
          "discount_percentage": { "type": "number" },
          "start_date": { "type": "string", "format": "date" },
          "end_date": { "type": "string", "format": "date" }
        }
      },
      "ActualizarPromocion": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 3, "maxLength": 150 },
          "description": { "type": "string" },
          "discount_percentage": { "type": "number" },
          "start_date": { "type": "string", "format": "date" },
          "end_date": { "type": "string", "format": "date" },
          "is_active": { "type": "boolean" }
        }
      },
      "SuccessRestaurante": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "$ref": "#/components/schemas/Restaurante" }
        }
      },
      "SuccessListRestaurante": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Restaurante" }
          }
        }
      },
      "Restaurante": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "logo_url": { "type": "string" },
          "is_active": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
